{
  "name": "frontend-evaluator",
  "version": "1.0.0",
  "description": "Comprehensive frontend webpage evaluation system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "frontend",
    "evaluation",
    "static-analysis",
    "code-quality",
    "performance",
    "security",
    "accessibility"
  ],
  "author": "Frontend Evaluation System",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "acorn": "^8.11.0",
    "acorn-walk": "^8.3.2",
    "js-yaml": "^4.1.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "postcss-selector-parser": "^6.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "fast-check": "^4.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
