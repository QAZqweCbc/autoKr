{
  "name": "kiro-account-server",
  "version": "1.0.0",
  "description": "Kiro Account Manager - Ubuntu Server Edition",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node --project tsconfig.json --transpile-only src/index.ts",
    "dev:auth": "ts-node --project tsconfig.json --transpile-only src/auth-service/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:auth\"",
    "dev:wizard": "ts-node --project tsconfig.json --transpile-only src/setup-wizard/index.ts",
    "build": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "start": "node dist/index.js",
    "start:auth": "node dist/auth-service/index.js",
    "start:wizard": "node dist/setup-wizard/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "node scripts/verify-optimization.js",
    "setup": "ts-node --project tsconfig.json --transpile-only src/setup-wizard/index.ts",
    "setup:smtp": "ts-node --project tsconfig.json --transpile-only src/scripts/setup-smtp.ts",
    "setup:wizard": "node dist/setup-wizard/index.js",
    "quick:smtp": "ts-node --project tsconfig.json --transpile-only src/scripts/quick-setup-smtp.ts",
    "init:admin": "ts-node --project tsconfig.json --transpile-only src/scripts/init-admin.ts",
    "optimize:db": "ts-node --project tsconfig.json --transpile-only src/scripts/optimize-database.ts",
    "fix:sso-mapping": "ts-node --project tsconfig.json --transpile-only src/scripts/fix-sso-token-mapping.ts",
    "migrate:db-config": "ts-node --project tsconfig.json --transpile-only scripts/migrate-database-config.ts",
    "frontend:install": "cd frontend && npm install",
    "frontend:build": "cd frontend && npm run build",
    "frontend:deploy": "node scripts/deploy-frontend.js",
    "frontend:rollback": "node scripts/rollback-frontend.js",
    "deploy": "npm run frontend:deploy && npm run build"
  },
  "keywords": [
    "aws",
    "account",
    "automation",
    "server"
  ],
  "author": "Kiro",
  "license": "MIT",
  "dependencies": {
    "@types/express-rate-limit": "^5.1.3",
    "@types/nodemailer": "^7.0.9",
    "axios": "^1.13.4",
    "bcrypt": "^5.1.1",
    "cbor-x": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "http-proxy-middleware": "^3.0.5",
    "imap": "^0.8.19",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.3",
    "mysql2": "^3.16.3",
    "nodemailer": "^8.0.1",
    "playwright": "^1.58.2",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/imap": "^0.8.43",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.2.1",
    "@types/uuid": "^9.0.7",
    "concurrently": "^9.2.1",
    "fast-check": "^4.5.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
