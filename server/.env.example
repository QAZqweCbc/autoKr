# ==================== 服务端口配置 ====================
PORT=3000
AUTH_PORT=2233

# ==================== 开发模式配置 ====================
NODE_ENV=development
SKIP_ADMIN_AUTH=false

# ==================== 安全配置（必需） ====================
# JWT密钥 - 用于生成和验证JWT Token
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here-generate-with-command-above

# 内部API密钥 - 用于主服务和认证服务之间的通信
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIN_API_KEY=your-main-api-key-here-generate-with-command-above

# 管理员密码 - 首次启动时创建管理员账号使用
# 如果不设置，系统会自动生成随机密码并在控制台显示
# 密码要求：至少8位，包含字母和数字
ADMIN_PASSWORD=your-secure-admin-password-change-this

# JWT过期时间（可选，默认24小时）
JWT_EXPIRES_IN=24h

# 加密密钥（可选，用于敏感数据加密）
ENCRYPTION_KEY=your-encryption-key-here

# ==================== 数据库配置 ====================
# 存储模式: json | mysql | redis
STORAGE_MODE=json
DATABASE_STORAGE=json

# MySQL配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=KrioServer

# Redis配置（可选，用于缓存和Session）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== 主服务API配置 ====================
# 主服务API地址（认证服务调用主服务时使用）
MAIN_API_URL=http://localhost:3000

# ==================== 邮箱配置 ====================
# QQ邮箱配置
QQ_EMAIL=your-email@qq.com
QQ_AUTH_CODE=your-qq-auth-code-here
EMAIL_DOMAINS=example.com

# Gmail配置（可选）
GMAIL_BASE=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password-here

# ==================== 其他配置 ====================
# 自动刷新Token（可选）
AUTO_REFRESH_ENABLED=false
AUTO_REFRESH_INTERVAL=3600000

# 日志级别（可选）
LOG_LEVEL=info

# 服务器配置（兼容旧版）
SERVER_PORT=3000
