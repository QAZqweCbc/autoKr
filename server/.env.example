# ============================================
# Kiro Account Manager - 环境变量配置
# ============================================

# --------------------------------------------
# 🔐 安全配置（必需）
# --------------------------------------------

# 加密密钥（必需）- 用于加密敏感数据（密码、授权码等）
# 生成命令: openssl rand -base64 32
# 或: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-32-character-or-longer-encryption-key-here

# JWT 密钥（必需）- 用于签名认证令牌
# 生成命令: openssl rand -base64 32
JWT_SECRET=your-32-character-or-longer-jwt-secret-here

# CORS 允许的来源（必需）- 逗号分隔多个来源
# 开发环境示例:
ALLOWED_ORIGINS=http://localhost:1455,http://localhost:5173,http://127.0.0.1:1455,http://127.0.0.1:5173
# 生产环境示例:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --------------------------------------------
# 🌐 服务端口配置
# --------------------------------------------

# 主服务端口
PORT=1455

# 认证服务端口
AUTH_PORT=2233

# 认证服务URL（用于代理）
AUTH_SERVICE_URL=http://localhost:2233

# --------------------------------------------
# 🗄️ 数据库配置
# --------------------------------------------

# 存储类型: json | mysql | redis
DATABASE_STORAGE=json

# MySQL 配置（当 DATABASE_STORAGE=mysql 时需要）
# 注意：推荐使用 /setup 页面配置 MySQL，密码会写入 config/database.config.json
# 环境变量仅用于覆盖 Setup Wizard 中设置的配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=KrioServer

# Redis 配置（当 DATABASE_STORAGE=redis 时需要，或作为 MySQL 缓存）
# 同上，推荐使用 /setup 页面配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------
# 📧 邮箱配置（可选）
# --------------------------------------------

# SMTP 配置（用于发送验证码邮件）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@qq.com
# SMTP_PASSWORD=your-smtp-auth-code
# SMTP_FROM="Kiro Account System" <your-email@qq.com>

# --------------------------------------------
# 🔧 其他配置
# --------------------------------------------

# Node 环境
NODE_ENV=development

# 日志级别: error | warn | info | debug
LOG_LEVEL=info

# --------------------------------------------
# 📝 配置说明
# --------------------------------------------

# 1. 加密密钥和JWT密钥必须设置，否则服务无法启动
# 2. 生产环境必须使用强密钥（至少32字符）
# 3. CORS配置必须明确指定允许的来源，不要使用 *
# 4. 数据库密码等敏感信息不要提交到版本控制
# 5. 定期轮换密钥以提高安全性

# --------------------------------------------
# 🚀 快速开始
# --------------------------------------------

# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 生成加密密钥和JWT密钥
#    openssl rand -base64 32
#
# 3. 修改 .env 文件中的配置
#
# 4. 启动服务
#    npm run dev
