# Dependencies
node_modules/
frontend/node_modules/

# Build output
dist/
# frontend/dist/  # 如果需要提交前端构建产物，取消此行注释
# public/assets/  # 如果需要提交公共资源，取消此行注释

# Data
data/
*.db
*.db-journal

# Database config (contains sensitive info)
# config/database.config.json  # 如果需要提交配置，注释此行
config/*.json
!config/database.config.json  # 允许提交数据库配置

# Logs
*.log
npm-debug.log*
logs/

# Environment
.env
.env.local
.env.production
.env.*.local

# Screenshots and debug files
*.png
*.jpg
# *.html  # 警告：这会忽略所有HTML文件，包括 dist/index.html
debug-*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
.kiro

# PM2
ecosystem.config.js
.pm2/

# Test
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
