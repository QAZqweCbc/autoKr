# Docker Compose 可选覆盖配置
# 使用方式：复制到项目根目录 .env，或在启动命令前设置同名环境变量。

KIRO_PORT=14558
ALLOWED_ORIGINS=http://localhost:14558,http://127.0.0.1:14558

# 默认连接宿主机已有 MySQL/Redis。
# Linux Docker 通过 compose 中的 host.docker.internal:host-gateway 映射访问宿主机。
DATABASE_STORAGE=mysql
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=kiro
MYSQL_PASSWORD=please_change_mysql_password
MYSQL_DATABASE=KrioServer

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

LOG_LEVEL=info

# true 时，如果数据库环境变量齐全，容器会自动写入 .setup-completed 并直接连接数据库。
KIRO_AUTO_SETUP_FROM_ENV=true
